# ============================================================================
# UPgrade API — Environment Configuration (.env.example)
# ============================================================================

# Environment mode: development | test | production
NODE_ENV=development

# HTTP Port (Render / Railway injects PORT automatically in production)
PORT=4000

# Frontend SPA origin allowed by CORS (no trailing slash)
# Local dev: http://localhost:5173
# Production (Vercel): https://your-upgrade-app.vercel.app
CLIENT_URL=http://localhost:5173

# PostgreSQL 16 Connection String
# Local Docker: postgresql://upgrade:upgrade_local_password@localhost:5432/upgrade?schema=public
# Neon / Supabase Production: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# JWT Signing Secret (minimum 32 characters; generate with `openssl rand -hex 32`)
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN_DAYS=7

# Optional Cookie SameSite override: lax | none
# Defaults to 'lax' in development and 'none' (with Secure=true) in cross-domain production.
# Set COOKIE_SAMESITE=lax in production if you proxy /api/* through Vercel rewrites (first-party cookies).
# COOKIE_SAMESITE=lax
