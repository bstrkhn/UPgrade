# Server
NODE_ENV=development
PORT=4000

# Frontend origin allowed by CORS (credentials enabled)
CLIENT_URL=http://localhost:5173

# PostgreSQL 16 - Neon / Supabase connection string, or local Docker:
# postgresql://upgrade:upgrade_local_password@localhost:5432/upgrade?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# JWT (use a random string of at least 32 characters, e.g. `openssl rand -hex 32`)
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN_DAYS=7
